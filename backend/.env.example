# Local SQLite
DATABASE_URL=sqlite:///./caseforge_new.db

# Production Vercel: use a persistent PostgreSQL database.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.vercel\.app

# Leaderboard season reset. The packaged build starts a fresh board here.
LEADERBOARD_RESET_AT=2026-09-13T01:21:40+00:00
